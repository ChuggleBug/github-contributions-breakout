{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "types": [
            "vite/client"
        ],
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "skipLibCheck": true,
        "isolatedModules": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "rootDir": "lib",
        "outDir": "dist"
    },
    "include": [
        "lib"
    ]
}