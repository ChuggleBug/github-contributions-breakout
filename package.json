{
    "name": "breakout",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "vite",
        "build:demo": "vite build",
        "build:lib": "vite build --config vite.config.lib.ts",
        "build:iife": "vite build --config vite.config.iife.ts",
        "build": "npm run build:lib && npm run build:iife && npm run build:demo",
        "preview": "vite preview --outDir dist-app",
        "lint": "eslint .",
        "format": "prettier --write ."
    },
    "files": [
        "dist-lib"
    ],
    "main": "./dist-lib/breakout.cjs",
    "module": "./dist-lib/breakout.js",
    "types": "./dist-lib/index.d.ts",
    "unpkg": "./dist-lib/breakout.iife.js",
    "jsdelivr": "./dist-lib/breakout.iife.js",
    "exports": {
        ".": {
            "types": "./dist-lib/index.d.ts",
            "import": "./dist-lib/breakout.js",
            "require": "./dist-lib/breakout.cjs"
        },
        "./react": {
            "types": "./dist-lib/react.d.ts",
            "import": "./dist-lib/react.js",
            "require": "./dist-lib/react.cjs"
        },
        "./iife": "./dist-lib/breakout.iife.js",
        "./style.css": "./dist-lib/breakout.css"
    },
    "sideEffects": [
        "**/*.css"
    ],
    "peerDependencies": {
        "react": ">=18",
        "react-dom": ">=18"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        },
        "react-dom": {
            "optional": true
        }
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@eslint/js": "^10.0.1",
        "@rolldown/plugin-babel": "^0.2.4",
        "@tailwindcss/vite": "^4.3.3",
        "@types/babel__core": "^7.20.5",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "babel-plugin-react-compiler": "^1.0.0",
        "esbuild": "^0.28.2",
        "eslint": "^10.13.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "prettier-plugin-curly": "^0.4.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-icons": "^5.7.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vite-plugin-dts": "^5.1.2"
    }
}
